# 4-Fit 미러팅 로컬 AI 설정 — 복사해서 사용: cp .env.example .env
# 모든 값은 app/core/config.py 기본값을 덮어쓴다 (접두사 MIRROR_TING_).
# API 키 불필요 원칙: 아래 전부 로컬 실행 구성 요소만 사용한다.

# 대화 엔진: template(항상 동작) | ollama(후속/압박 질문을 로컬 LLM이 개인화, 실패 시 템플릿 폴백)
# 준비: scripts/setup_ai.sh 실행 (Ollama + exaone3.5:2.4b + bge-m3)
MIRROR_TING_DIALOGUE_PROVIDER=ollama

# faster-whisper 모델 크기: small(기본, 권장) | base(더 빠름, 정확도 하락)
# i7-8750H 실측: small CER 4.8% / RTF 0.28, base CER 10.8% / RTF 0.24
#MIRROR_TING_STT_WHISPER_MODEL=small

# STT 핫워드 부스팅 — 브랜드 메뉴명·사내 용어의 오전사 감소 (비우면 비활성).
# 새 시나리오 팩을 추가하면 그 팩의 고유 명사를 덧붙일 것.
#MIRROR_TING_STT_INITIAL_PROMPT=카페 온도, 온도라떼, 유자온도, 온도 콜드브루, 크림 온도, 온도 포인트, 클라우드밋, 플로우데스크, 에스컬레이션, 러시타임

# 개인화 질문 생성 타임아웃(초) — 초과 시 템플릿 질문 즉시 폴백.
# 전시 PC가 더 빠르면 낮춰도 된다 (i7-8750H 워밍 평균 4.1s 기준 7s).
#MIRROR_TING_OLLAMA_TIMEOUT_SEC=7.0

# 임베딩 모델(의미 매칭): bge-m3(기본, 한국어 우수) | nomic-embed-text(더 가벼움)
#MIRROR_TING_OLLAMA_EMBED_MODEL=bge-m3

# 떨림(jitter/shimmer) 감점 임계 — 합성 신호 보정 기본값. 전시 PC 마이크 보정
# (demo-checklist §2.5)에서 안정된 육성에 "피치 흔들림"이 뜨면 상향한다.
#MIRROR_TING_TREMOR_JITTER_FLOOR=6.0
#MIRROR_TING_TREMOR_SHIMMER_FLOOR=8.0
#MIRROR_TING_TREMOR_PENALTY_CAP=18.0

# 운영 API 보호 토큰 — /api/admin(전시 초기화·CSV 내보내기) 호출에 X-Admin-Token
# 헤더로 요구된다. 비우면 로컬(같은 PC)에서만 접근 가능. 전시장 네트워크에서는 반드시 설정.
# 운영 대시보드(/admin) 첫 진입 시 같은 값을 입력하면 브라우저에 저장된다.
MIRROR_TING_ADMIN_TOKEN=

# JWT 서명 시크릿 (S-B2B-SEC) — 계정 로그인 기능 사용 시 반드시 무작위 값으로 변경.
# HS256 권장 최소 32바이트. 생성 예:
#   ./.venv/Scripts/python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
# 기본값(change-me-in-production)으로 기동하면 경고가 출력되고, require_secure=true면 기동 거부.
#MIRROR_TING_JWT_SECRET=change-me-in-production

# 전시/운영 배포 안전장치 — true면 기본 JWT 시크릿·빈 admin 토큰으로 기동을 거부한다.
# 기관(B2B) 배포에서는 반드시 true + admin_auth_required=true 권장.
#MIRROR_TING_REQUIRE_SECURE=false
#MIRROR_TING_ADMIN_AUTH_REQUIRED=false

# ---- B2B 온보딩 확장 ----

# NFC 리더 브리지 (S-B2B-NFC, ACR122U) — pyscard 미설치·리더 미연결이면 자동 휴면.
# 리더 연결 순서(인덱스)로 역할 배정: 1대면 "mirror", 2대면 "mirror,kiosk".
#MIRROR_TING_NFC_BRIDGE_ENABLED=true
#MIRROR_TING_NFC_READER_ROLES=mirror,kiosk

# 영수증 QR 클레임 링크 베이스 (S-B2B-CLAIM) — 웹앱(poc/frontend)의 /claim 화면 주소.
# 전시장에서는 관람객 휴대폰이 접근 가능한 주소(같은 네트워크의 웹앱 호스트)로 설정.
#MIRROR_TING_CLAIM_BASE_URL=http://localhost:5173/claim

# LLM judge (S-B2B-JUDGE) — Response-Fit 루브릭 CoT 채점. 0이면 비활성.
# 표본 수 n(중앙값)·혼합 비중 w: final = (1-w)×결정적 + w×judge 중앙값.
#MIRROR_TING_JUDGE_SAMPLES=3
#MIRROR_TING_JUDGE_BLEND_WEIGHT=0.3
#MIRROR_TING_JUDGE_TIMEOUT_SEC=20.0
